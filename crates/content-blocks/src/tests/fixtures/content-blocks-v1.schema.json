        "title": {
          "description": "Card title.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Copyable": {
      "description": "A value that provides a copy action.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Label describing the value.",
          "type": [
            "string",
            "null"
