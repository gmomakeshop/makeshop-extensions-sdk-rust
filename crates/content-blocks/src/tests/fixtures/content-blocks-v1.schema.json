        {
          "description": "A short label.",
          "type": "object",
          "properties": {
            "text": {
              "description": "Text displayed in the label.",
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "badge"
            },
            "variant": {
              "description": "Presentation intent of the label.",
              "$ref": "#/$defs/Variant"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "variant",
            "text"
          ]
        },
        {
          "description": "A QR code.",
          "type": "object",
          "properties": {
            "caption": {
              "description": "Caption displayed with the QR code.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1024,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "qr"
            },
            "value": {
              "description": "Value encoded in the QR code.",
