          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A container for notices and guidance.",
          "type": "object",
          "properties": {
            "blocks": {
              "description": "Leaf blocks displayed inside the container.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Leaf"
              },
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "alert"
            },
            "variant": {
              "description": "Presentation intent.",
              "$ref": "#/$defs/Variant"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "variant",
            "blocks"
          ]
        },
        {
          "description": "A group of content with an optional heading.",
          "type": "object",
          "properties": {
            "blocks": {
              "description": "Blocks displayed in the section. A section cannot contain another section.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SectionChild"
              },
              "minItems": 1
            },
            "heading": {
              "description": "Optional heading.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1024,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "section"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "blocks"
          ]
        },
        {
          "description": "A container that displays cards or images in a grid.",
          "type": "object",
          "properties": {
            "columns-hint": {
              "description": "Preferred column count. The rendered column count may vary by display environment.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 4,
              "minimum": 2
            },
            "items": {
              "description": "Cards or images to display.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/GridItem"
