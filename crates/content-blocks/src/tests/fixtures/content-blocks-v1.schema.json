          "description": "A heading.",
          "type": "object",
          "properties": {
            "level": {
              "description": "Heading level.",
              "type": "integer",
              "format": "uint8",
              "maximum": 3,
              "minimum": 1
            },
            "text": {
              "description": "Heading text.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "heading"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "level"
          ]
        },
        {
          "description": "A paragraph.",
          "type": "object",
          "properties": {
            "spans": {
              "description": "Spans to display.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Span"
              },
              "minItems": 1
