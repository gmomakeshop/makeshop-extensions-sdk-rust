              "items": {
                "$ref": "#/$defs/FieldEntry"
              },
              "maxItems": 16,
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "fields"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entries"
          ]
        },
        {
          "description": "A value that can be copied.",
          "type": "object",
          "properties": {
            "label": {
              "description": "Label describing the value.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1024,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "copyable"
            },
            "value": {
              "description": "Value to copy.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A link.",
          "type": "object",
          "properties": {
            "prominence": {
              "description": "Visual prominence.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Prominence"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "description": "Link text.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "link"
            },
            "url": {
              "description": "HTTPS destination URL.",
              "type": "string",
              "pattern": "^https://[^/?#]+"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "url"
          ]
        },
        {
          "description": "An image.",
          "type": "object",
          "properties": {
            "alt": {
              "description": "Alternative text for the image.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
