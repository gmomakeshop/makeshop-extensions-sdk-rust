        {
          "description": "Collapsible content.",
          "type": "object",
          "properties": {
            "blocks": {
              "description": "Leaf blocks shown when the content is expanded.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Leaf"
              },
              "minItems": 1
            },
            "summary": {
              "description": "Summary shown while the content is collapsed.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "accordion"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "summary",
            "blocks"
          ]
        }
