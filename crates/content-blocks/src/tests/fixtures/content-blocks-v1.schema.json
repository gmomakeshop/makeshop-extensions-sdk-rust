{
  "$id": "https://makeshop.dev/schemas/managed-runtime/content-blocks-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentBlocksV1",
  "description": "A single fragment's Content Blocks array. Runtime validation additionally checks UTF-8 byte limits, URL hygiene, table row widths, and limits across fragments.",
  "type": "array",
  "examples": [
    [
      {
        "spans": [
          {
            "text": "Thank you for your order."
          }
        ],
        "type": "text"
      }
    ]
  ],
  "items": {
    "$ref": "#/$defs/Block"
  },
  "maxItems": 64,
  "x-block-payloads": {
    "accordion": {
      "$ref": "#/$defs/Accordion"
    },
    "alert": {
      "$ref": "#/$defs/Alert"
    },
    "badge": {
      "$ref": "#/$defs/Badge"
    },
    "card": {
      "$ref": "#/$defs/Card"
    },
    "copyable": {
      "$ref": "#/$defs/Copyable"
    },
    "divider": {
      "$ref": "#/$defs/Divider"
    },
    "fields": {
      "$ref": "#/$defs/Fields"
    },
    "grid": {
      "$ref": "#/$defs/Grid"
    },
    "heading": {
      "$ref": "#/$defs/Heading"
    },
    "image": {
      "$ref": "#/$defs/Image"
    },
    "link": {
      "$ref": "#/$defs/Link"
    },
    "list": {
      "$ref": "#/$defs/List"
    },
    "qr": {
      "$ref": "#/$defs/Qr"
    },
    "section": {
      "$ref": "#/$defs/Section"
    },
    "table": {
      "$ref": "#/$defs/Table"
    },
    "text": {
      "$ref": "#/$defs/Text"
    }
  },
  "x-schema-version": 1,
  "$defs": {
    "Accordion": {
      "description": "Collapsible content.",
      "type": "object",
      "properties": {
        "blocks": {
          "description": "Leaf blocks shown when the content is expanded.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Leaf"
          },
          "minItems": 1
        },
        "summary": {
          "description": "Summary shown while the content is collapsed.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "summary",
        "blocks"
      ]
    },
    "Alert": {
      "description": "A container for notices and guidance.",
      "type": "object",
      "properties": {
        "blocks": {
          "description": "Leaf blocks displayed inside the container.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Leaf"
          },
          "minItems": 1
        },
        "variant": {
          "description": "Presentation intent.",
          "$ref": "#/$defs/Variant"
        }
      },
      "additionalProperties": false,
      "required": [
        "variant",
        "blocks"
      ]
    },
    "Badge": {
      "description": "A short label representing a rank, restriction, status, or similar property.",
      "type": "object",
      "properties": {
        "text": {
          "description": "Text displayed in the label.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "variant": {
          "description": "Presentation intent of the label.",
          "$ref": "#/$defs/Variant"
        }
      },
      "additionalProperties": false,
      "required": [
        "variant",
        "text"
      ]
    },
    "Block": {
