      "description": "A container that displays cards or images in a grid.",
      "type": "object",
      "properties": {
        "columns-hint": {
          "description": "Preferred column count. The rendered column count may vary by display environment.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 4,
          "minimum": 2
