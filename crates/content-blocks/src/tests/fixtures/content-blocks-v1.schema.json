            "type": {
              "type": "string",
              "const": "image"
            },
            "url": {
              "description": "HTTPS URL of the image.",
              "type": "string",
              "pattern": "^https://[^/?#]+"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "alt"
          ]
        },
        {
          "description": "A divider.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "divider"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "A table.",
          "type": "object",
          "properties": {
            "columns": {
              "description": "Column headings.",
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              "maxItems": 6,
              "minItems": 1
            },
            "rows": {
              "description": "Table rows. Each row must contain the same number of cells as there are columns.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1024,
                  "minLength": 1
                },
                "maxItems": 6,
                "minItems": 1
              },
              "maxItems": 20,
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "table"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows"
          ]
        },
        {
          "description": "A bulleted or numbered list.",
          "type": "object",
          "properties": {
            "items": {
              "description": "List items.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Span"
                },
                "minItems": 1
              },
              "maxItems": 16,
              "minItems": 1
            },
            "style": {
              "description": "Marker style.",
              "$ref": "#/$defs/ListStyle"
            },
            "type": {
              "type": "string",
              "const": "list"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "style",
            "items"
          ]
        },
        {
          "description": "A card.",
          "type": "object",
          "properties": {
            "body": {
              "description": "Card body.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Span"
              },
              "minItems": 1
            },
            "image": {
              "description": "Image displayed on the card.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Image"
                },
                {
                  "type": "null"
                }
              ]
            },
            "link": {
              "description": "Link opened from the card.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Link"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "description": "Card title.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
